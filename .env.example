COMPANY_LLM_API_URL=https://skax.ai-talentlab.com
COMPANY_LLM_API_KEY=
COMPANY_LLM_MODEL=gpt-4.1-mini
COMPANY_LLM_API_VERSION=2024-12-01-preview
COMPANY_LLM_TIMEOUT_SECONDS=30
COMPANY_LLM_SCHEMA_RETRIES=1
COMPANY_LLM_USE_MOCK=
DATABASE_PATH=data/mailtaskagent.db
AGENT_CONFIDENCE_THRESHOLD=0.75

# Optional read-only test Gmail Adapter. Use a separate test account and
# synthetic mail under this label only. OAuth files stay under .secrets/.
GMAIL_CREDENTIALS_PATH=.secrets/gmail_credentials.json
GMAIL_TOKEN_PATH=.secrets/gmail_token.json
GMAIL_QUERY=label:MailTaskAgent-Demo
GMAIL_MAX_RESULTS=25

# Optional Slack incoming webhook. The URL is a secret and must stay only in .env.
# Notifications are off until explicitly enabled.
SLACK_NOTIFICATIONS_ENABLED=false
SLACK_WEBHOOK_URL=
SLACK_NOTIFICATION_TIMEOUT_SECONDS=5
